# Copy to .env.local (local) and add the same names in Vercel (Project Settings -> Environment Variables).
# Find these in Supabase: Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET. Server only. Never prefix with NEXT_PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=
# Your site address, used in email links (e.g. https://your-app.vercel.app)
NEXT_PUBLIC_SITE_URL=
