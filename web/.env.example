# Copy to .env.local (local) and add the same names in Vercel (Project Settings -> Environment Variables).
# Find the Supabase values in: Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET. Server only. Never prefix with NEXT_PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=
# Your site address, used in email links (e.g. https://your-app.vercel.app)
NEXT_PUBLIC_SITE_URL=
# Optional: email for application received / rejected / job updates (resend.com). Without it, emails are only logged.
RESEND_API_KEY=
EMAIL_FROM=Scale to Thrive <no-reply@your-domain.com>
# Optional fallback only. Normally set the mail account in Admin -> Email settings (no Vercel variables needed).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
